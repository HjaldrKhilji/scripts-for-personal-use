#Now ofcourse you will have to extract the rootfs.gz:
#extra rootfs's ( the file thats inside rootfs.gz ) content to the respective partition that is to be the root of the other system, in my case tiny core:
#add this to /etc/grub.d/40_custom:
#!/bin/sh
exec tail -n +3 $0
# This file provides an easy way to add custom menu entries.  Simply type the
# menu entries you want to add after this comment.  Be careful not to change
# the 'exec tail' line above.
menuentry 'tiny-core linux' --class linux --class gnu-linux --class gnu --class os $menuentry_id_option 'linux-tinycore-808536ca-a857-444e-84c4-309ba5b6b525' {
                load_video
                insmod chain
                insmod part_gpt
                insmod fat
                search --no-floppy --fs-uuid --set=root b1ad027f-e3fc-4937-85ea-1a34a0b61a92
                echo    'Loading UKI tinycore.efi ...'
		chainloader	/EFI/Linux/tinycore.efi  ro quiet resume=PARTUUID='89d25cfd-8f81-42d7-a80b-439323a04033'

        }
#the UUID="a1f3e11c-226a-4875-a76e-687a0ccb1862" in the line below is only necessery if there is a seperate var partiton:
#		chainloader	/EFI/Linux/linux-6.18.43-gentoo-dist-fe9c81f34f6ab11e2dba0c476a82ecbb.efi root=UUID=a1f3e11c-226a-4875-a76e-687a0ccb1862 ro single net.ifnames=1 quiet splash resume=PARTUUID='89d25cfd-8f81-42d7-a80b-439323a04033'


