#!/bin/sh
exec tail -n +3 $0
# This file provides an easy way to add custom menu entries.  Simply type the
# menu entries you want to add after this comment.  Be careful not to change
# the 'exec tail' line above.
menuentry 'tiny-core linux' --class linux --class gnu-linux --class gnu --class os $menuentry_id_option 'linux-tinycore-808536ca-a857-444e-84c4-309ba5b6b525' {
                load_video
                insmod chain
                insmod part_gpt
                insmod fat
                search --no-floppy --fs-uuid --set=root 7065-BAB0
                echo    'Loading UKI tinycore.efi ...'
                chainloader     /EFI/Linux/tinycore.efi root=UUID=b1ad027f-e3fc-4937-85ea-1a34a0b61a92 ro quiet resume=PARTUUID>
        }

#and then simply run:
grub-mkconfig -o /efi/EFI/Gentoo/grub.cfg


